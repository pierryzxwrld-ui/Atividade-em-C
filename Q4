#include <stdio.h>

int main() {
    int passos_hora, total_passos = 0, horas = 0;

    printf("=== Monitoramento de Meta Diaria de Passos ===\n\n");

    // Loop executado ate atingir ou ultrapassar 10.000 passos
    while (total_passos < 10000) {
        horas++;
        
        do {
            printf("Digite a quantidade de passos na hora %d: ", horas);
            scanf("%d", &passos_hora);

            if (passos_hora < 0) {
                printf("Quantidade invalida! Digite um valor maior ou igual a zero.\n");
            }
        } while (passos_hora < 0);

        // Acumula os passos informados
        total_passos += passos_hora;
        printf("Total acumulado ate agora: %d passos\n\n", total_passos);
    }

    // Exibicao dos resultados finais
    printf("=======================================\n");
    printf("Parabens! A meta de 10.000 passos foi atingida!\n");
    printf("Total de passos acumulados: %d\n", total_passos);
    printf("Horas necessarias: %d hora(s)\n", horas);
    printf("=======================================\n");

    return 0;
}
