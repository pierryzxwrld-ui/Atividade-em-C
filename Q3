#include <stdio.h>

int main() {
    float nota, soma_notas = 0.0, media_geral;
    int i;

    printf("=== Avaliacao do Atendimento da Loja ===\n\n");

    // Loop para ler a nota de 10 clientes
    for (i = 1; i <= 10; i++) {
        do {
            printf("Digite a nota do cliente %d (0 a 10): ", i);
            scanf("%f", &nota);

            // Validacao da nota inserida
            if (nota < 0.0 || nota > 10.0) {
                printf("Nota invalida! A nota deve estar entre 0 e 10.\n");
            }
        } while (nota < 0.0 || nota > 10.0);

        // Somatorio das notas recebidas
        soma_notas += nota;
    }

    // Calculo da media geral
    media_geral = soma_notas / 10.0;

    // Exibicao dos resultados
    printf("\n=======================================\n");
    printf("Media geral de atendimento: %.2f\n", media_geral);

    // Condicional para alerta de media baixa
    if (media_geral < 7.0) {
        printf("ALERTA: A media do atendimento esta abaixo do esperado (menor que 7.0)!\n");
    } else {
        printf("Atendimento aprovado com boa avaliacao!\n");
    }
    printf("=======================================\n");

    return 0;
}
